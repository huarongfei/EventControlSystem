# EventControlSystem 环境变量配置
# 复制此文件为 .env 并填写实际值: cp .env.example .env
#
# 开发环境（SQLite）：大部分配置有默认值，可直接运行
# 生产环境（PostgreSQL + Docker）：必须设置所有带 [必需] 标记的变量

# ─── 服务器 ────────────────────────
PORT=3001
NODE_ENV=development

# ─── 数据库 ────────────────────────
# SQLite（开发默认）
DATABASE_URL="file:./dev.db"
# PostgreSQL（生产环境用 Docker Compose 启动）
# DATABASE_URL="postgresql://ecs:change_me@postgres:5432/ecs?schema=public"

# ─── 安全 [生产环境必需] ──────────
# JWT 签名密钥 — 生产环境必须设置为随机字符串（至少32字符）
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRES_IN=24h

# ─── 跨域 ──────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
# SOCKET_CORS_ORIGIN=*   # Socket.IO CORS（开发环境允许所有来源）

# ─── 日志 ──────────────────────────
LOG_LEVEL=info            # debug | info | warn | error

# ─── 前端 URL ──────────────────────
APP_URL=http://localhost:5173

# ─── Docker / PostgreSQL（仅生产）───
POSTGRES_USER=ecs
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=ecs

<Window x:Class="BroadcastControl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BroadcastControl.ViewModels"
        Title="导播控制台 - EventControlSystem"
        Width="1400" Height="900"
        MinWidth="1200" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Brushes (Define first) -->
        <SolidColorBrush x:Key="BgDark" Color="#0a0a0f"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12121a"/>
        <SolidColorBrush x:Key="BgCard" Color="#1a1a28"/>
        <SolidColorBrush x:Key="BgHover" Color="#252538"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4361ee"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#4cc9f0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#06d6a0"/>
        <SolidColorBrush x:Key="AccentRed" Color="#ef233c"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#f39c12"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#9b59b6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8b8b9e"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5a5a6e"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2a2a3e"/>

        <!-- Value Converters (Define after brushes they reference) -->
        <vm:BoolToThicknessConverter x:Key="BoolToThicknessConverter" 
                                      TrueThickness="2" FalseThickness="0"/>
        <vm:BoolToBrushConverter x:Key="BoolToBrushConverter"
                                  TrueBrush="{StaticResource AccentRed}" 
                                  FalseBrush="{StaticResource TextMuted}"/>
        <vm:TransitionModeToColorConverter x:Key="TransitionModeToColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <vm:VirtualCameraButtonConverter x:Key="VirtualCameraButtonConverter"/>
        <vm:VirtualCameraButtonColorConverter x:Key="VirtualCameraButtonColorConverter"/>

        <!-- Glow Effects -->
        <DropShadowEffect x:Key="GlowBlue" ShadowDepth="0" BlurRadius="20" Color="#4361ee" Opacity="0.5"/>
        <DropShadowEffect x:Key="GlowRed" ShadowDepth="0" BlurRadius="20" Color="#ef233c" Opacity="0.5"/>
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="4" BlurRadius="20" Color="#000000" Opacity="0.4"/>

        <!-- Scene Button Style -->
        <Style x:Key="SceneButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource AccentBlue}"
                                BorderThickness="{Binding IsActive, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToThicknessConverter}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Camera Button Style -->
        <Style x:Key="CameraButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect" Value="{StaticResource GlowBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transition Button Style -->
        <Style x:Key="TransitionButton" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="32,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="180"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" Padding="12,12"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentRed}" Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="📺" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="导播控制台" Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Broadcast Control" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Scene Presets -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Scenes}" Margin="12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.SelectSceneAsyncCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SceneButton}">
                                            <Setter Property="Background" Value="{StaticResource BgCard}"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- Right-click context menu for preset management -->
                                <Button Content="⋮" Width="20" Height="20" Margin="2,4,0,4"
                                        Background="Transparent" Foreground="{StaticResource TextMuted}"
                                        BorderThickness="0" Cursor="Hand" FontSize="10"
                                        Command="{Binding DataContext.SelectPresetForEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.ToolTip>
                                        <ToolTip Content="管理预设"/>
                                    </Button.ToolTip>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="更新此预设" 
                                                      Command="{Binding DataContext.UpdatePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="删除此预设" 
                                                      Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Save Preset -->
                <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="8,6" 
                        Margin="8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100" Padding="6,4" FontSize="12" Margin="0,0,6,0"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 ToolTip="预设名称" VerticalContentAlignment="Center"/>
                        <Button Content="保存预设" Command="{Binding SaveCurrentAsPresetCommand}"
                                Background="{StaticResource AccentPurple}" Foreground="White"
                                Padding="8,4" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Connection -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="8,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" Padding="6,4" FontSize="11"
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0" ToolTip="WebSocket 服务器地址"/>
                            <Border Background="{StaticResource BgDark}" CornerRadius="4" Padding="6,4" Margin="4,0">
                                <TextBox Text="{Binding MatchId, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" Padding="2,2" FontSize="11"
                                         Background="Transparent" Foreground="{StaticResource AccentCyan}"
                                         BorderThickness="0" ToolTip="比赛 ID"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                <Button Content="↓" ToolTip="获取场景" Command="{Binding FetchBroadcastSceneAsyncCommand}"
                                        Background="{StaticResource AccentBlue}" Foreground="White"
                                        Padding="6,4" FontSize="10" BorderThickness="0" Cursor="Hand" Margin="0,0,3,0"/>
                                <Button Content="↑" ToolTip="推送场景" Command="{Binding PushBroadcastSceneAsyncCommand}"
                                        Background="{StaticResource AccentGreen}" Foreground="White"
                                        Padding="6,4" FontSize="10" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                            <Button Content="{Binding ConnectionButtonText}" Command="{Binding ConnectCommand}"
                                    Background="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"
                                    Foreground="White" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                    BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="❔" ToolTip="帮助 (F1)" Style="{StaticResource IconButton}"
                            FontSize="14" Command="{Binding OpenHelpCommand}" Width="36" Height="36"/>
                    <Button Content="⌨" ToolTip="快捷键 (F2)" Style="{StaticResource IconButton}"
                            FontSize="14" Margin="6,0,0,0" Command="{Binding ToggleShortcutHelpCommand}" Width="36" Height="36"/>
                    <Button Content="🎓" ToolTip="新手引导" Style="{StaticResource IconButton}"
                            FontSize="14" Margin="6,0,0,0" Command="{Binding StartTutorialCommand}" Width="36" Height="36"/>
                    <Button Content="⚙" ToolTip="设置" Style="{StaticResource IconButton}"
                            FontSize="14" Margin="6,0,0,0" Command="{Binding OpenSettingsCommand}" Width="36" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transition Bar -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" Padding="16,10"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Transition Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="CUT" Command="{Binding SetTransitionModeCommand}" CommandParameter="CUT"
                            Style="{StaticResource TransitionButton}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding TransitionMode, Converter={StaticResource TransitionModeToColorConverter}, ConverterParameter=CUT}"/>
                        </Button.Background>
                    </Button>
                    <Button Content="AUTO" Command="{Binding SetTransitionModeCommand}" CommandParameter="AUTO"
                            Style="{StaticResource TransitionButton}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding TransitionMode, Converter={StaticResource TransitionModeToColorConverter}, ConverterParameter=AUTO}"/>
                        </Button.Background>
                    </Button>
                    <Button Content="FADE" Command="{Binding SetTransitionModeCommand}" CommandParameter="FADE"
                            Style="{StaticResource TransitionButton}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding TransitionMode, Converter={StaticResource TransitionModeToColorConverter}, ConverterParameter=FADE}"/>
                        </Button.Background>
                    </Button>
                    <Button Content="WIPE" Command="{Binding SetTransitionModeCommand}" CommandParameter="WIPE"
                            Style="{StaticResource TransitionButton}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding TransitionMode, Converter={StaticResource TransitionModeToColorConverter}, ConverterParameter=WIPE}"/>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <!-- Virtual Camera Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVirtualCameraRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#06d6a0" Opacity="0.7"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding VirtualCameraStatus}" Foreground="{StaticResource TextSecondary}" 
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Live Indicator -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="14" Height="14" Margin="0,0,10,0">
                        <Ellipse Fill="{StaticResource AccentRed}" Opacity="0.3">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1.8" ScaleY="1.8" CenterX="7" CenterY="7"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Fill="{StaticResource AccentRed}"/>
                    </Grid>
                    <TextBlock Text="ON AIR" Foreground="{StaticResource AccentRed}" 
                               FontSize="18" FontWeight="Bold" FontFamily="Consolas"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview Panel -->
            <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="16" 
                    Padding="16" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📹 预览画面" Foreground="{StaticResource TextSecondary}" 
                               FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <!-- Preview Grid -->
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <Border Background="{StaticResource BgDark}" CornerRadius="12" Margin="4"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="2">
                            <Grid>
                                <Border Background="#228B22" Margin="8" CornerRadius="8" Opacity="0.6"/>
                                <TextBlock Text="CAM 1" Foreground="{StaticResource TextMuted}"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentGreen}" CornerRadius="4" Padding="6,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                    <TextBlock Text="PVW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="12" Margin="4"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="2">
                            <Grid>
                                <Border Background="#1E50B4" Margin="8" CornerRadius="8" Opacity="0.6"/>
                                <TextBlock Text="CAM 2" Foreground="{StaticResource TextMuted}"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="12" Margin="4"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="2">
                            <Grid>
                                <Border Background="#B41E1E" Margin="8" CornerRadius="8" Opacity="0.6"/>
                                <TextBlock Text="CAM 3" Foreground="{StaticResource TextMuted}"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="12" Margin="4"
                                BorderBrush="{StaticResource BorderColor}" BorderThickness="2">
                            <Grid>
                                <Border Background="#A07828" Margin="8" CornerRadius="8" Opacity="0.6"/>
                                <TextBlock Text="CAM 4" Foreground="{StaticResource TextMuted}"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Camera Selection -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Cameras}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}"
                                        Command="{Binding DataContext.CutToCameraCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CameraButton}">
                                            <Setter Property="Background" Value="{StaticResource BgHover}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentRed}"/>
                                                    <Setter Property="Effect" Value="{StaticResource GlowRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- PGM Output -->
            <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="16" 
                    Margin="16,0,0,0" Padding="16" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🎬 PGM 输出" Foreground="{StaticResource AccentRed}" 
                                   FontSize="16" FontWeight="Bold"/>
                        <TextBlock Grid.Column="2" Text="{Binding ProgramCamera.Label, FallbackValue='CAM1'}" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    </Grid>

                    <!-- Video Output Area -->
                    <Border Grid.Row="1" Background="{StaticResource BgDark}" CornerRadius="12" Margin="0,12,0,0">
                        <Grid>
                            <!-- Simulated Video -->
                            <Border Background="#0d2818" Margin="8" CornerRadius="10">
                                <Grid>
                                    <Border Background="#228B22" Margin="12" CornerRadius="8" Opacity="0.7"/>
                                    <TextBlock Text="{Binding ProgramCamera.Label, FallbackValue='CAM1'}" 
                                               Foreground="White" FontSize="48" FontWeight="Bold" Opacity="0.3"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Score Overlay -->
                            <Border Background="#cc000000" VerticalAlignment="Bottom" 
                                    Padding="24,14" Margin="16,0,16,16" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding HomeTeamName}" 
                                               Foreground="White" FontSize="24" FontWeight="Bold" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding HomeScore}" 
                                               Foreground="{StaticResource AccentCyan}" FontSize="40" 
                                               FontWeight="Bold" Margin="20,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="-" Foreground="White" 
                                               FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding AwayScore}" 
                                               Foreground="{StaticResource AccentCyan}" FontSize="40" 
                                               FontWeight="Bold" Margin="20,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding AwayTeamName}" 
                                               Foreground="White" FontSize="24" FontWeight="Bold" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Timer Overlay -->
                            <Border Background="#99000000" Padding="12,6" 
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0" 
                                    CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimerDisplay}" Foreground="White" 
                                               FontSize="20" FontWeight="Bold" FontFamily="Consolas"/>
                                    <TextBlock Text="  Q" Foreground="{StaticResource TextMuted}" 
                                               FontSize="16" FontWeight="Bold" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding CurrentPeriod}" Foreground="{StaticResource AccentOrange}" 
                                               FontSize="20" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <!-- LIVE Badge -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0">
                                <Grid Width="12" Height="12" Margin="0,0,8,0">
                                    <Ellipse Fill="{StaticResource AccentRed}" Opacity="0.4">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="2" ScaleY="2" CenterX="6" CenterY="6"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse Fill="{StaticResource AccentRed}"/>
                                </Grid>
                                <TextBlock Text="LIVE" Foreground="{StaticResource AccentRed}" 
                                           FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Slow Motion Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" Padding="16,10"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Slow Motion Control -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="⏪ 慢动作" Foreground="{StaticResource TextSecondary}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="● IN" Command="{Binding MarkSlowMotionInCommand}"
                            Background="{Binding SlowMotionMarkedIn, Converter={StaticResource BoolToBrushConverter}}"
                            Foreground="White" Padding="16,6" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="● OUT" Command="{Binding MarkSlowMotionOutCommand}"
                            Background="{Binding SlowMotionMarkedOut, Converter={StaticResource BoolToBrushConverter}}"
                            Foreground="White" Padding="16,6" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="▶ 播放" Command="{Binding PlaySlowMotionAsyncCommand}"
                            Background="{StaticResource AccentBlue}" Foreground="White"
                            Padding="16,6" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="■ 停止" Command="{Binding StopSlowMotionAsyncCommand}"
                            Background="{StaticResource AccentRed}" Foreground="White"
                            Padding="16,6" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,6,0"/>
                    <Button Content="↺ 清除" Command="{Binding ClearSlowMotionMarksCommand}"
                            Background="{StaticResource BgCard}" Foreground="{StaticResource TextSecondary}"
                            Padding="16,6" FontSize="12" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,12,0"/>
                    <!-- Speed selector -->
                    <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="4,2" Margin="0,0,6,0">
                        <ComboBox SelectedItem="{Binding SlowMotionSpeed}" Padding="6,3" FontSize="11"
                                  Background="Transparent" Foreground="White" BorderThickness="0"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="0.25x"/>
                            <ComboBoxItem Content="0.5x"/>
                            <ComboBoxItem Content="0.75x"/>
                            <ComboBoxItem Content="1.0x"/>
                        </ComboBox>
                    </Border>
                    <TextBlock Text="{Binding SlowMotionStatus}" Foreground="{StaticResource TextMuted}"
                               FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Virtual Camera Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVirtualCameraRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentGreen}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="虚拟摄像机" Foreground="{StaticResource TextSecondary}" 
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Content="{Binding IsVirtualCameraRunning, Converter={StaticResource VirtualCameraButtonConverter}, FallbackValue=启动}" 
                                    Command="{Binding ToggleVirtualCameraAsyncCommand}"
                                    Background="{Binding IsVirtualCameraRunning, Converter={StaticResource VirtualCameraButtonColorConverter}, FallbackValue={StaticResource AccentGreen}}"
                                    Foreground="White" Padding="12,4" FontSize="11" FontWeight="SemiBold"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Overlay Toggles -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="叠加层:" Foreground="{StaticResource TextSecondary}" 
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <CheckBox Content="比分" IsChecked="{Binding ShowScore}" 
                              Foreground="White" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
                    <CheckBox Content="计时" IsChecked="{Binding ShowTimer}" 
                              Foreground="White" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
                    <CheckBox Content="队名" IsChecked="{Binding ShowTeamNames}" 
                              Foreground="White" FontSize="12" Margin="6,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Event Log -->
        <Border Grid.Row="4" Background="{StaticResource BgDark}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgCard}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📋 事件日志" Foreground="{StaticResource TextSecondary}" 
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding EventLog.Count, StringFormat='{}{0} 条记录'}" 
                                   Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8">
                    <ItemsControl ItemsSource="{Binding EventLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12,8" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayTime}" 
                                                   Foreground="{StaticResource TextMuted}" FontSize="12" FontFamily="Consolas"/>
                                        <Border Grid.Column="1" Background="{Binding TypeBrush}" CornerRadius="4" 
                                                Padding="6,2" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" 
                                                   Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" VerticalAlignment="Bottom" Background="#0f0f14" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentOrange}" FontSize="12"/>
        </Border>

        <!-- Tutorial Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#cc000000"
                Visibility="{Binding ShowTutorial, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="200">
            <Border Background="{StaticResource BgCard}" CornerRadius="20" Width="500"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding TutorialTitle}" Foreground="{StaticResource AccentCyan}" 
                               FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TutorialContent}" Foreground="White" FontSize="18" 
                               FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TutorialDescription}" Foreground="{StaticResource TextSecondary}" 
                               FontSize="14" Margin="0,0,0,24" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding TutorialProgress}" Maximum="100" Height="4" 
                                 Background="{StaticResource BgDark}" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="跳过引导" Command="{Binding SkipTutorialCommand}"
                                Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                Padding="16,8" FontSize="13" BorderThickness="0" Margin="0,0,12,0"/>
                        <Button Content="{Binding TutorialNextButtonText}" Command="{Binding NextTutorialStepCommand}"
                                Background="{StaticResource AccentBlue}" Foreground="White"
                                Padding="24,10" FontSize="14" BorderThickness="0" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Help Modal -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#cc000000"
                Visibility="{Binding ShowHelp, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="100">
            <Border Background="{StaticResource BgCard}" CornerRadius="20" Width="650" MaxHeight="750"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="使用帮助" Foreground="White" FontSize="24" 
                                   FontWeight="Bold" Margin="0,0,0,20"/>
                        <Button Grid.Column="1" Content="X" Command="{Binding CloseHelpCommand}"
                                Background="Transparent" Foreground="{StaticResource TextMuted}"
                                BorderThickness="0" FontSize="16" Cursor="Hand" Width="32" Height="32"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Quick Start -->
                            <TextBlock Text="快速入门" Foreground="{StaticResource AccentCyan}" 
                                       FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4">
                                    <Run Text="1." FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 连接服务器 - 输入 WebSocket 服务器地址，点击连接按钮"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4">
                                    <Run Text="2." FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 场景预设 - 点击顶部场景按钮快速切换布局，或保存当前画面为预设"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4">
                                    <Run Text="3." FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 切换摄像机 - 点击 CAM 按钮或按数字键 1-6 切换"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4">
                                    <Run Text="4." FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 转场控制 - CUT/AUTO/FADE/WIPE 四种转场模式"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4">
                                    <Run Text="5." FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 慢动作 - 标记入点/出点后播放慢动作回放"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,20">
                                    <Run Text="6." FontWeight="Bold" Foreground="White"/>
                                    <Run Text=" 虚拟摄像机 - 点击底部的虚拟摄像机按钮启停"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Keyboard Shortcuts -->
                            <TextBlock Text="键盘快捷键" Foreground="{StaticResource AccentCyan}" 
                                       FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="摄像机切换" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="1-6     切换摄像机" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="C        CUT 即切" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="A        AUTO 转场" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="慢动作控制" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="[        标记入点" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="]        标记出点" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="Ctrl+S   播放慢动作" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="其他操作" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                                    <TextBlock Text="F1       帮助" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="F2       快捷键列表" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="Ctrl+V   虚拟摄像机" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4" FontFamily="Consolas"/>
                                    <TextBlock Text="Esc      关闭弹窗" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Consolas"/>
                                </StackPanel>
                            </Grid>

                            <!-- Scene Shortcuts -->
                            <TextBlock Text="场景快速切换" Foreground="{StaticResource AccentCyan}" 
                                       FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                            <StackPanel>
                                <TextBlock Text="F5-F8   快速切换前4个场景预设" Foreground="{StaticResource TextSecondary}" FontSize="13" FontFamily="Consolas"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="关闭" Command="{Binding CloseHelpCommand}"
                            Background="{StaticResource AccentBlue}" Foreground="White"
                            Padding="32,10" FontSize="14" BorderThickness="0" 
                            HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </Grid>
            </Border>
        </Border>

        <!-- Keyboard Shortcut Help Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#99000000"
                Visibility="{Binding ShowShortcutHelp, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="150"
                MouseLeftButtonDown="ShortcutHelp_Click">
            <Border Background="{StaticResource BgCard}" CornerRadius="16" Width="420" 
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="28" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="键盘快捷键" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <Button Grid.Column="1" Content="X" Command="{Binding ToggleShortcutHelpCommand}"
                                Background="Transparent" Foreground="{StaticResource TextMuted}"
                                BorderThickness="0" FontSize="14" Cursor="Hand" Width="28" Height="28"/>
                    </Grid>
                    <StackPanel Margin="0,0,0,8">
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="1 - 6" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="切换摄像机 CAM1-CAM6" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="C" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="切换到 CUT 模式（即时切换）" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="A" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="切换到 AUTO 模式（自动转场）" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="[ ]" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="标记慢动作入点/出点" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="F5-F8" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="快速切换场景预设 1-4" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="Ctrl+S" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="播放慢动作" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="Ctrl+V" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="开启/关闭虚拟摄像机" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgHover}" CornerRadius="4" Padding="4,2">
                                    <TextBlock Text="F1 / Esc" Foreground="{StaticResource AccentCyan}" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="帮助 / 关闭弹窗" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="按 F2 或点击任意位置关闭" Foreground="{StaticResource TextMuted}" 
                               FontSize="11" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

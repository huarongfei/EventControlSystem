<Window x:Class="BroadcastControl.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BroadcastControl.ViewModels"
        xmlns:models="clr-namespace:BroadcastControl.Models"
        xmlns:local="clr-namespace:BroadcastControl.Views"
        Title="设置 - Broadcast Control"
        Width="900" Height="650"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#0a0a0f"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12121a"/>
        <SolidColorBrush x:Key="BgCard" Color="#1a1a28"/>
        <SolidColorBrush x:Key="BgHover" Color="#252538"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4361ee"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#4cc9f0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#06d6a0"/>
        <SolidColorBrush x:Key="AccentRed" Color="#ef233c"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8b8b9e"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5a5a6e"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2a2a3e"/>

        <DropShadowEffect x:Key="CardShadow" ShadowDepth="4" BlurRadius="20" Color="#000000" Opacity="0.4"/>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Tab Button Style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{StaticResource AccentBlue}" Width="40" Height="40" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="系统设置" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Broadcast Control Settings" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Bar -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabGeneral" Content="📡 常规设置" Style="{StaticResource TabButton}"
                        Click="TabGeneral_Click" Foreground="{StaticResource AccentCyan}" BorderBrush="{StaticResource AccentBlue}"/>
                <Button x:Name="TabCameras" Content="📹 摄像机配置" Style="{StaticResource TabButton}"
                        Click="TabCameras_Click"/>
                <Button x:Name="TabRecording" Content="⏺ 录制设置" Style="{StaticResource TabButton}"
                        Click="TabRecording_Click"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" Background="{StaticResource BgDark}">
            <!-- General Settings Tab -->
            <ScrollViewer x:Name="PanelGeneral" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="服务器连接" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="服务器地址" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="1" Text="{Binding ServerUrl}" Padding="12,10" FontSize="14"
                                     Background="{StaticResource BgDark}" Foreground="White"
                                     BorderBrush="{StaticResource BorderColor}" BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="转场设置" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="默认转场模式" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="1" SelectedItem="{Binding DefaultTransition}" Padding="12,10" FontSize="14"
                                      Background="{StaticResource BgDark}" Foreground="White" Margin="0,0,0,16">
                                <ComboBoxItem Content="CUT (硬切)"/>
                                <ComboBoxItem Content="AUTO (淡入淡出)"/>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="自动转场时长 (毫秒)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                            <Slider Grid.Row="3" Minimum="100" Maximum="2000" Value="{Binding AutoTransitionDuration}" 
                                    TickFrequency="100" IsSnapToTickEnabled="True"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="功能开关" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding AutoConnect}" Content="启动时自动连接服务器" 
                                      Foreground="White" FontSize="14" Margin="0,8"/>
                            <CheckBox IsChecked="{Binding EnableOverlay}" Content="启用比分叠加层" 
                                      Foreground="White" FontSize="14" Margin="0,8"/>
                            <CheckBox IsChecked="{Binding EnableSlowMotion}" Content="启用慢动作功能" 
                                      Foreground="White" FontSize="14" Margin="0,8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Camera Settings Tab -->
            <Grid x:Name="PanelCameras" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Camera List -->
                <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource BgPanel}" Padding="16,12">
                            <TextBlock Text="摄像机列表" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}"
                                 Background="Transparent" BorderThickness="0" Margin="8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="12,10" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0"
                                                    Background="{Binding PreviewBrush}">
                                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SourceTypeDisplayName}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="10" Height="10" Fill="{StaticResource AccentGreen}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                            <Button Content="+ 添加" Command="{Binding AddCameraCommand}" 
                                    Background="{StaticResource AccentGreen}" Foreground="White" Padding="16,8"/>
                            <Button Content="- 删除" Command="{Binding RemoveCameraCommand}" CommandParameter="{Binding SelectedCamera}"
                                    Background="{StaticResource AccentRed}" Foreground="White" Padding="16,8" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Camera Settings -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="24">
                    <StackPanel>
                        <TextBlock Text="摄像机配置" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        
                        <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                            <Grid IsEnabled="{Binding SelectedCamera, Converter={StaticResource NullToBoolConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="摄像机名称" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                                <TextBox Grid.Row="1" Text="{Binding SelectedCamera.Name, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" FontSize="14"
                                         Background="{StaticResource BgDark}" Foreground="White" Margin="0,0,0,16"/>

                                <TextBlock Grid.Row="2" Text="信号源类型" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                                <ComboBox Grid.Row="3" SelectedItem="{Binding SelectedCamera.SourceType}" Padding="12,10" FontSize="14"
                                          Background="{StaticResource BgDark}" Foreground="White" Margin="0,0,0,16">
                                    <ComboBoxItem Content="纯色背景" Tag="{x:Static models:CameraSourceType.Color}"/>
                                    <ComboBoxItem Content="图片文件" Tag="{x:Static models:CameraSourceType.Image}"/>
                                    <ComboBoxItem Content="视频文件" Tag="{x:Static models:CameraSourceType.Video}"/>
                                    <ComboBoxItem Content="NDI输入" Tag="{x:Static models:CameraSourceType.NDI}"/>
                                    <ComboBoxItem Content="采集设备" Tag="{x:Static models:CameraSourceType.CaptureDevice}"/>
                                </ComboBox>

                                <!-- Resolution -->
                                <TextBlock Grid.Row="4" Text="分辨率" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                                <ComboBox Grid.Row="5" SelectedItem="{Binding SelectedCamera.Resolution}" Padding="12,10" FontSize="14"
                                          Background="{StaticResource BgDark}" Foreground="White" Margin="0,0,0,16">
                                    <ComboBoxItem Content="1920x1080"/>
                                    <ComboBoxItem Content="1280x720"/>
                                    <ComboBoxItem Content="3840x2160"/>
                                    <ComboBoxItem Content="640x480"/>
                                </ComboBox>

                                <!-- Frame Rate -->
                                <TextBlock Grid.Row="6" Text="帧率 (FPS)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                                <ComboBox Grid.Row="7" SelectedItem="{Binding SelectedCamera.FrameRate}" Padding="12,10" FontSize="14"
                                          Background="{StaticResource BgDark}" Foreground="White" Margin="0,0,0,16">
                                    <ComboBoxItem Content="24"/>
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="30"/>
                                    <ComboBoxItem Content="50"/>
                                    <ComboBoxItem Content="60"/>
                                </ComboBox>

                                <!-- Color Selection -->
                                <TextBlock Grid.Row="8" Text="背景颜色" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                                <WrapPanel Grid.Row="9">
                                    <Button Width="40" Height="40" Margin="4" Background="#228B22" Click="ColorButton_Click" Tag="#228B22"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#1E50B4" Click="ColorButton_Click" Tag="#1E50B4"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#B41E1E" Click="ColorButton_Click" Tag="#B41E1E"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#A07828" Click="ColorButton_Click" Tag="#A07828"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#4361ee" Click="ColorButton_Click" Tag="#4361ee"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#9b59b6" Click="ColorButton_Click" Tag="#9b59b6"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#34495e" Click="ColorButton_Click" Tag="#34495e"/>
                                    <Button Width="40" Height="40" Margin="4" Background="#e74c3c" Click="ColorButton_Click" Tag="#e74c3c"/>
                                </WrapPanel>

                                <!-- Preview button -->
                                <Button Grid.Row="10" Content="刷新预览" Command="{Binding UpdateCameraPreviewCommand}"
                                        Background="{StaticResource AccentGreen}" Foreground="White" Padding="16,8"
                                        FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="媒体文件" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="20">
                            <Grid IsEnabled="{Binding SelectedCamera, Converter={StaticResource NullToBoolConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="文件路径" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8"/>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding SelectedCamera.MediaPath}" Padding="12,10" FontSize="14"
                                             Background="{StaticResource BgDark}" Foreground="White" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseMediaFileCommand}"
                                            Background="{StaticResource AccentBlue}" Foreground="White" Padding="20,10" Margin="8,0,0,0"/>
                                </Grid>
                                <Border Grid.Row="2" Background="{StaticResource BgDark}" CornerRadius="8" Padding="16" Margin="0,16,0,0" Height="150">
                                    <Image Source="{Binding SelectedCamera.PreviewImage}" Stretch="Uniform" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Recording Settings Tab -->
            <ScrollViewer x:Name="PanelRecording" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="录制设置" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding EnableRecording}" Content="启用录制功能" 
                                      Foreground="White" FontSize="14" Margin="0,8"/>
                            <TextBlock Text="录制文件保存位置" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,16,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding RecordPath}" Padding="12,10" FontSize="14"
                                         Background="{StaticResource BgDark}" Foreground="White" IsReadOnly="True"/>
                                <Button Grid.Column="1" Content="浏览..." Command="{Binding BrowseRecordPathCommand}"
                                        Background="{StaticResource AccentBlue}" Foreground="White" Padding="20,10" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" Padding="20,16" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="CancelButton_Click"
                        Background="Transparent" Foreground="{StaticResource TextSecondary}"
                        Padding="24,10" FontSize="14" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Margin="0,0,12,0"/>
                <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" Click="SaveButton_Click"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

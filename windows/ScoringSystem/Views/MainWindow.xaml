<Window x:Class="ScoringSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScoringSystem.ViewModels"
        xmlns:pages="clr-namespace:ScoringSystem.Views.Pages"
        Title="计分裁判系统 - EventControlSystem"
        Width="1280" Height="880"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#0a0a0f"
        ResizeMode="CanResize"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <vm:BoolToBrushConverter x:Key="BoolToBrushConverter" TrueBrush="#4cc9f0" FalseBrush="#555"/>
        <vm:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <vm:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <vm:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- Nav Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Padding="14,12"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="icon" Grid.Column="0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" x:Name="badge" CornerRadius="10" 
                                        Background="#ef233c" Padding="6,2" Margin="8,0,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="badgeText" Text="" Foreground="White" 
                                               FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1e1e2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Score Button Style -->
        <Style x:Key="ScoreButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="4" BlurRadius="20" Color="#000000" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.95" ScaleY="0.95"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Timer Button Style -->
        <Style x:Key="TimerButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop Shadow Effects -->
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="4" BlurRadius="20" Color="#000000" Opacity="0.4"/>
        <DropShadowEffect x:Key="GlowCyan" ShadowDepth="0" BlurRadius="15" Color="#4cc9f0" Opacity="0.4"/>
        <DropShadowEffect x:Key="GlowBlue" ShadowDepth="0" BlurRadius="20" Color="#4361ee" Opacity="0.5"/>
        <DropShadowEffect x:Key="GlowGreen" ShadowDepth="0" BlurRadius="15" Color="#06d6a0" Opacity="0.4"/>

        <!-- Color Brushes -->
        <SolidColorBrush x:Key="BgDark" Color="#0a0a0f"/>
        <SolidColorBrush x:Key="BgPanel" Color="#12121a"/>
        <SolidColorBrush x:Key="BgCard" Color="#1a1a28"/>
        <SolidColorBrush x:Key="BgHover" Color="#252538"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#4361ee"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#4cc9f0"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#06d6a0"/>
        <SolidColorBrush x:Key="AccentRed" Color="#ef233c"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#f39c12"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#9b59b6"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8b8b9e"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5a5a6e"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2a2a3e"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="220"/>
            <!-- Main Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#0d0d14"
                BorderBrush="#1e1e2e" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,22,20,18"
                        BorderBrush="#1e1e2e" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Background="#4361ee" Width="34" Height="34" CornerRadius="10" Margin="0,0,10,0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="#4361ee" Opacity="0.6"/>
                                </Border.Effect>
                                <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="计分系统" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="ScoringSystem" Foreground="#5a5a6e" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <TextBlock Text="主功能" Foreground="#3a3a5e" FontSize="11" FontWeight="Bold"
                               Margin="22,0,0,6"/>

                    <!-- Connection -->
                    <Button Tag="🔗" Command="{Binding NavigateCommand}" CommandParameter="connection"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="connection"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="服务器连接"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="connection">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Match Select -->
                    <Button Tag="🏀" Command="{Binding NavigateCommand}" CommandParameter="match_select"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="match_select"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="选择比赛"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="match_select">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Match Management -->
                    <Button Tag="⚙" Command="{Binding NavigateCommand}" CommandParameter="management"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="management"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="比赛管理"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="management">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Team Management -->
                    <Button Tag="👥" Command="{Binding NavigateCommand}" CommandParameter="team_management"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="team_management"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="队伍管理"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="team_management">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Scoring -->
                    <Button Tag="📊" Command="{Binding NavigateCommand}" CommandParameter="scoring"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="scoring"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="计分主页"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="scoring">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Event Log -->
                    <Button Tag="📋" Command="{Binding NavigateCommand}" CommandParameter="event_log"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="event_log"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="事件日志"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="event_log">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Border Height="1" Background="#1e1e2e" Margin="16,12"/>
                    <TextBlock Text="工具" Foreground="#3a3a5e" FontSize="11" FontWeight="Bold"
                               Margin="22,0,0,6"/>

                    <!-- Settings -->
                    <Button Tag="⚙" Command="{Binding NavigateCommand}" CommandParameter="settings"
                            Style="{StaticResource NavButton}" Foreground="{StaticResource TextSecondary}">
                        <Button.Background>
                            <SolidColorBrush>
                                <SolidColorBrush.Color>
                                    <MultiBinding>
                                        <MultiBinding.Converter>
                                            <vm:StringEqualsColorConverter TrueColor="#252538" FalseColor="Transparent"/>
                                        </MultiBinding.Converter>
                                        <Binding Path="CurrentPage"/>
                                        <Binding Source="settings"/>
                                    </MultiBinding>
                                </SolidColorBrush.Color>
                            </SolidColorBrush>
                        </Button.Background>
                        <TextBlock FontSize="13" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="系统设置"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage}" Value="settings">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <!-- Bottom Status Panel -->
                <Border Grid.Row="2" Padding="16,14"
                        BorderBrush="#1e1e2e" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Connection indicator -->
                        <Border Background="#12121a" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0">
                                    <Ellipse Fill="{Binding IsConnected, Converter={StaticResource BoolToBrushConverter}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#8b8b9e" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="10" Foreground="#3a3a5e" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Text>
                                            <Binding Path="ServerUrl" StringFormat="{}{0}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Selected Match -->
                        <Border Background="#12121a" CornerRadius="10" Padding="12,10"
                                Visibility="{Binding SelectedMatch, Converter={StaticResource NullToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding MatchStatusText}" Foreground="#4361ee" 
                                           FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding SelectedMatch.DisplayName}" Foreground="#8b8b9e" 
                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT AREA ===== -->
        <Grid Grid.Column="1">
            <!-- Connection Page -->
            <pages:ConnectionPage Visibility="{Binding IsConnectionPage, Converter={StaticResource BoolToVisConverter}}"
                                  DataContext="{Binding}"/>

            <!-- Match Select Page -->
            <pages:MatchSelectPage Visibility="{Binding IsMatchSelectPage, Converter={StaticResource BoolToVisConverter}}"
                                   DataContext="{Binding}"/>

            <!-- Match Management Page -->
            <pages:MatchManagementPage Visibility="{Binding IsManagementPage, Converter={StaticResource BoolToVisConverter}}"
                                       DataContext="{Binding}"/>

            <!-- Team Management Page -->
            <pages:TeamManagementPage Visibility="{Binding IsTeamManagementPage, Converter={StaticResource BoolToVisConverter}}"
                                     DataContext="{Binding}"/>

            <!-- Scoring Page -->
            <Grid Visibility="{Binding IsScoringPage, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Match Info Bar -->
                <Border Grid.Row="0" Background="#12121a" Padding="24,14"
                        BorderBrush="#2a2a3e" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="计分主页" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedMatch.DisplayName}" Foreground="#8b8b9e" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding MatchStatusBrush}" CornerRadius="8" 
                                Padding="14,6" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MatchStatusText}" Foreground="White" 
                                       FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <Button Grid.Column="2" Content="🔀 换场" Command="{Binding NavigateCommand}" 
                                CommandParameter="match_select"
                                Background="#252538" Foreground="#8b8b9e"
                                Padding="14,8" FontSize="12" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Score Display -->
                <Grid Grid.Row="1" Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Home Team -->
                    <Border Grid.Column="0" Background="#1a1a28" CornerRadius="20" Padding="24" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#4361ee" CornerRadius="12" 
                                    Padding="16,10" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="{Binding HomeTeamName}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </Border>
                            <Border Grid.Row="1" Background="#0a0a0f" CornerRadius="16" Margin="0,0,0,16" MinHeight="160">
                                <TextBlock Text="{Binding HomeScore}" Foreground="#4cc9f0"
                                           FontSize="120" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Effect="{StaticResource GlowCyan}"/>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="犯规: " Foreground="#8b8b9e" FontSize="15"/>
                                <TextBlock Text="{Binding HomeFouls}" Foreground="#ef233c" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <UniformGrid Grid.Row="3" Columns="3">
                                <Button Content="+1" Command="{Binding HomeScorePlus1Command}"
                                        Style="{StaticResource ScoreButton}" Background="#2196F3" Foreground="White"/>
                                <Button Content="+2" Command="{Binding HomeScorePlus2Command}"
                                        Style="{StaticResource ScoreButton}" Background="#1976D2" Foreground="White"/>
                                <Button Content="+3" Command="{Binding HomeScorePlus3Command}"
                                        Style="{StaticResource ScoreButton}" Background="#1565C0" Foreground="White"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Center Controls -->
                    <Grid Grid.Column="1" Width="160" Margin="16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Away team actions (top) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <Button Content="⏸ 暂停" Command="{Binding AwayTimeoutCommand}"
                                    Style="{StaticResource ActionButton}" Background="#f39c12"/>
                            <Button Content="🔄 换人" Command="{Binding AwaySubstitutionCommand}"
                                    Style="{StaticResource ActionButton}" Background="#9b59b6"/>
                            <Button Content="🚫 犯规" Command="{Binding AwayFoulCommand}"
                                    Style="{StaticResource ActionButton}" Background="#ef233c"/>
                        </StackPanel>

                        <!-- VS Badge -->
                        <Border Grid.Row="2" Background="#1a1a28" CornerRadius="50" 
                                Width="72" Height="72" HorizontalAlignment="Center"
                                Effect="{StaticResource CardShadow}">
                            <TextBlock Text="VS" Foreground="#5a5a6e" FontSize="24" FontWeight="Bold" 
                                       FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Home team actions (bottom) -->
                        <StackPanel Grid.Row="4" Margin="0,12,0,0">
                            <Button Content="🚫 犯规" Command="{Binding HomeFoulCommand}"
                                    Style="{StaticResource ActionButton}" Background="#ef233c"/>
                            <Button Content="🔄 换人" Command="{Binding HomeSubstitutionCommand}"
                                    Style="{StaticResource ActionButton}" Background="#9b59b6"/>
                            <Button Content="⏸ 暂停" Command="{Binding HomeTimeoutCommand}"
                                    Style="{StaticResource ActionButton}" Background="#f39c12"/>
                        </StackPanel>
                    </Grid>

                    <!-- Away Team -->
                    <Border Grid.Column="2" Background="#1a1a28" CornerRadius="20" Padding="24" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#ef233c" CornerRadius="12" 
                                    Padding="16,10" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="{Binding AwayTeamName}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </Border>
                            <Border Grid.Row="1" Background="#0a0a0f" CornerRadius="16" Margin="0,0,0,16" MinHeight="160">
                                <TextBlock Text="{Binding AwayScore}" Foreground="#ef233c"
                                           FontSize="120" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Color="#ef233c" Opacity="0.4"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="犯规: " Foreground="#8b8b9e" FontSize="15"/>
                                <TextBlock Text="{Binding AwayFouls}" Foreground="#ef233c" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <UniformGrid Grid.Row="3" Columns="3">
                                <Button Content="+1" Command="{Binding AwayScorePlus1Command}"
                                        Style="{StaticResource ScoreButton}" Background="#e53935" Foreground="White"/>
                                <Button Content="+2" Command="{Binding AwayScorePlus2Command}"
                                        Style="{StaticResource ScoreButton}" Background="#c62828" Foreground="White"/>
                                <Button Content="+3" Command="{Binding AwayScorePlus3Command}"
                                        Style="{StaticResource ScoreButton}" Background="#b71c1c" Foreground="White"/>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Timer Control Bar -->
                <Border Grid.Row="2" Background="#12121a" Padding="20,14"
                        BorderBrush="#2a2a3e" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1a1a28" CornerRadius="12" Padding="20,10" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏱ " Foreground="#4cc9f0" FontSize="20"/>
                                <TextBlock Text="{Binding TimerDisplay}" Foreground="#4cc9f0"
                                           FontSize="32" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding PeriodText}" Foreground="#8b8b9e" 
                                           FontSize="15" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="▶ 开始" Command="{Binding StartTimerCommand}"
                                    Style="{StaticResource TimerButton}" Background="#06d6a0"/>
                            <Button Content="⏸ 暂停" Command="{Binding PauseTimerCommand}"
                                    Style="{StaticResource TimerButton}" Background="#f39c12"/>
                            <Button Content="↺ 重置" Command="{Binding ResetTimerCommand}"
                                    Style="{StaticResource TimerButton}" Background="#5a5a6e"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,16,0">
                            <Button Content="◀ 上节" Command="{Binding PreviousPeriodCommand}"
                                    Style="{StaticResource TimerButton}" Background="#252538"/>
                            <Button Content="下节 ▶" Command="{Binding NextPeriodCommand}"
                                    Style="{StaticResource TimerButton}" Background="#252538"/>
                        </StackPanel>
                        <Button Grid.Column="4" Content="🏁 结束比赛" Command="{Binding EndMatchCommand}"
                                Style="{StaticResource TimerButton}" Background="#ef233c" Padding="20,10"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Event Log Page -->
            <pages:EventLogPage Visibility="{Binding IsEventLogPage, Converter={StaticResource BoolToVisConverter}}"
                                DataContext="{Binding}"/>

            <!-- Settings Page -->
            <pages:SettingsPage Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisConverter}}"
                                DataContext="{Binding}"/>

            <!-- Status Bar (bottom of content area) -->
            <Border VerticalAlignment="Bottom" Background="#06060a" Padding="16,5"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#f39c12" FontSize="12"/>
            </Border>
        </Grid>

        <!-- Tutorial Overlay -->
        <Border Grid.ColumnSpan="2" Background="#cc000000"
                Visibility="{Binding ShowTutorial, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="200">
            <Border Background="#1a1a28" CornerRadius="20" Width="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="36" Effect="{StaticResource CardShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding TutorialTitle}" Foreground="#4cc9f0" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TutorialContent}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TutorialDescription}" Foreground="#8b8b9e" FontSize="14" Margin="0,0,0,24" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding TutorialProgress}" Maximum="100" Height="4" Background="#0a0a0f" Foreground="#4361ee" Margin="0,0,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="跳过引导" Command="{Binding SkipTutorialCommand}"
                                Background="Transparent" Foreground="#5a5a6e"
                                Padding="16,8" FontSize="13" BorderThickness="0" Margin="0,0,12,0" Cursor="Hand"/>
                        <Button Content="{Binding TutorialNextButtonText}" Command="{Binding NextTutorialStepCommand}"
                                Background="#4361ee" Foreground="White"
                                Padding="24,10" FontSize="14" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Help Modal -->
        <Border Grid.ColumnSpan="2" Background="#cc000000"
                Visibility="{Binding ShowHelp, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="100">
            <Border Background="#1a1a28" CornerRadius="20" Width="600" MaxHeight="680"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="❔ 使用帮助" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="快速入门" Foreground="#4cc9f0" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="1. 在「服务器连接」页面输入后端地址并连接" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="2. 在「选择比赛」页面选择赛事和比赛" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="3. 进入「计分主页」使用按钮或快捷键记录比分" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="4. 「事件日志」查看全部操作记录" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,16"/>
                            <TextBlock Text="键盘快捷键" Foreground="#4cc9f0" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="1/2/3 → 主队 +1/+2/+3 | 7/8/9 → 客队 +1/+2/+3" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock Text="Space → 开始/暂停 | ← → → 切换节次 | F1 → 帮助" Foreground="#8b8b9e" FontSize="13"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="关闭" Command="{Binding CloseHelpCommand}"
                            Background="#4361ee" Foreground="White"
                            Padding="32,10" FontSize="14" BorderThickness="0" 
                            HorizontalAlignment="Right" Margin="0,20,0,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- Player Selection Dialog for Scoring -->
        <Border Grid.ColumnSpan="2" Background="#cc000000"
                Visibility="{Binding IsPlayerSelectDialogOpen, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="150">
            <Border Background="#1a1a28" CornerRadius="20" Width="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="28">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="30" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="{Binding PlayerSelectTitle}" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,16" TextWrapping="Wrap"/>

                    <!-- Player List -->
                    <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailablePlayersForSelect}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0a0a0f" CornerRadius="10" Margin="0,0,0,8"
                                            Padding="16,12" Cursor="Hand" BorderThickness="1" BorderBrush="#2a2a3e">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.ConfirmPlayerSelectAndScoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#4361ee" CornerRadius="20" Width="40" Height="40" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="16" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Position}" Foreground="#5a5a6e" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- No Players Message -->
                    <TextBlock Grid.Row="2" Text="暂无球员数据" Foreground="#5a5a6e" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,20,0,0"
                               Visibility="{Binding AvailablePlayersForSelect.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=0}"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="取消" Command="{Binding CancelPlayerSelectCommand}"
                                Background="#252538" Foreground="#8b8b9e"
                                Padding="20,10" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,12,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="跳过球员选择" Command="{Binding CancelPlayerSelectCommand}"
                                Background="#4361ee" Foreground="White"
                                Padding="20,10" FontSize="13" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3a56d4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Foul Type Selection Dialog -->
        <Border Grid.ColumnSpan="2" Background="#cc000000"
                Visibility="{Binding IsFoulTypeDialogOpen, Converter={StaticResource BoolToVisConverter}}"
                Panel.ZIndex="150">
            <Border Background="#1a1a28" CornerRadius="20" Width="500"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="28">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="30" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MaxHeight="400"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="{Binding FoulTypeTitle}" Foreground="White"
                               FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                    <!-- Foul Type List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FoulTypes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Margin="0,0,0,8" Padding="16,14" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="#2a2a3e"
                                            MouseLeftButtonDown="FoulTypeItem_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#0a0a0f"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="severe">
                                                        <Setter Property="Background" Value="#1a1a10"/>
                                                        <Setter Property="BorderBrush" Value="#f39c12"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="dangerous">
                                                        <Setter Property="Background" Value="#200808"/>
                                                        <Setter Property="BorderBrush" Value="#ef233c"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <!-- Severity Emoji -->
                                            <TextBlock Text="{Binding Emoji}" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <!-- Name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <!-- Severity Label -->
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#252538"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="minor">
                                                                <Setter Property="Background" Value="#1a4d1a"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="common">
                                                                <Setter Property="Background" Value="#4d4d00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="severe">
                                                                <Setter Property="Background" Value="#4d2600"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="dangerous">
                                                                <Setter Property="Background" Value="#4d0000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SeverityName}" Foreground="#aaa" FontSize="11"/>
                                            </Border>
                                            <!-- Description & Penalty -->
                                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Description}" Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                <TextBlock Foreground="#666" FontSize="11">
                                                    <Run Text="处罚: "/><Run Text="{Binding Penalty}" Foreground="#f39c12"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="取消" Command="{Binding CancelFoulTypeSelectCommand}"
                                Background="#252538" Foreground="#8b8b9e"
                                Padding="20,10" FontSize="13" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>

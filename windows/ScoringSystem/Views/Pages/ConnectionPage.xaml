<UserControl x:Class="ScoringSystem.Views.Pages.ConnectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Width="520" HorizontalAlignment="Center">
            <!-- Logo -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                <Border Background="#4361ee" Width="52" Height="52" CornerRadius="16" Margin="0,0,16,0">
                    <TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="计分裁判系统" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="EventControlSystem · Scoring Module" Foreground="#8b8b9e" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <!-- Connection Card -->
            <Border Background="#1a1a28" CornerRadius="20" Padding="32">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="30" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="连接到比赛服务器" Foreground="White" FontSize="20" 
                               FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="输入后端服务器地址，支持本机或局域网内的远程服务器" 
                               Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,28" TextWrapping="Wrap"/>

                    <!-- Server URL Input -->
                    <TextBlock Text="服务器地址" Foreground="#8b8b9e" FontSize="13" 
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Background="#0a0a0f" CornerRadius="10" BorderBrush="#2a2a3e" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#252538" CornerRadius="10,0,0,10" 
                                    Padding="12,0" Width="50">
                                <TextBlock Text="🔗" FontSize="18" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="14,14" FontSize="15" FontFamily="Consolas"
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0" VerticalAlignment="Center"
                                     ToolTip="例如：ws://localhost:3001 或 ws://192.168.1.100:3001"/>
                        </Grid>
                    </Border>

                    <!-- Quick Preset Buttons -->
                    <WrapPanel Margin="0,12,0,24">
                        <TextBlock Text="快速填充：" Foreground="#5a5a6e" FontSize="12" 
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="本机 localhost" 
                                Command="{Binding SetLocalhostCommand}"
                                Background="#252538" Foreground="#8b8b9e"
                                Padding="10,5" FontSize="11" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="局域网 192.168..." 
                                Command="{Binding SetLanAddressCommand}"
                                Background="#252538" Foreground="#8b8b9e"
                                Padding="10,5" FontSize="11" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>

                    <!-- History Servers -->
                    <Border Visibility="{Binding HasServerHistory, Converter={StaticResource BoolToVisConverter}}"
                            Background="#12121a" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="历史连接" Foreground="#5a5a6e" FontSize="12" 
                                       FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ServerHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" 
                                                Command="{Binding DataContext.SelectHistoryUrlCommand, 
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#4cc9f0"
                                                Padding="0,4" BorderThickness="0" Cursor="Hand"
                                                HorizontalAlignment="Left" FontFamily="Consolas" FontSize="13">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock x:Name="txt" Text="{TemplateBinding Content}" 
                                                               Foreground="#4cc9f0" FontFamily="Consolas"
                                                               FontSize="13" Padding="{TemplateBinding Padding}"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Status Message -->
                    <Border Background="#0f0f14" CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConnectionPageIcon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" 
                                       FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Connect Button -->
                    <Button Command="{Binding ConnectCommand}" Cursor="Hand"
                            Height="52" FontSize="16" FontWeight="Bold"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="12"
                                        Background="{TemplateBinding Background}">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#4361ee" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#4361ee"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#ef233c"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConnectionButtonIcon}" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ConnectionButtonText}" FontSize="16" FontWeight="Bold" 
                                       Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Connection Info -->
            <Border Margin="0,20,0,0" Background="#12121a" CornerRadius="12" Padding="20"
                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="✅ 已连接到服务器" Foreground="#06d6a0" 
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ServerUrl}" Foreground="#8b8b9e" 
                                   FontSize="12" FontFamily="Consolas"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="进入比赛 →" 
                            Command="{Binding NavigateToMatchSelectCommand}"
                            Background="#4361ee" Foreground="White"
                            Padding="20,10" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>

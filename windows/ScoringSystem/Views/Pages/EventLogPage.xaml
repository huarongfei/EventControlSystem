<UserControl x:Class="ScoringSystem.Views.Pages.EventLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#12121a" Padding="28,20"
                BorderBrush="#2a2a3e" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="事件日志" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding EventLog.Count, StringFormat='共 {0} 条事件记录'}" 
                               Foreground="#8b8b9e" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🖨 打印" Command="{Binding PrintScoreSheetCommand}"
                            Background="#252538" Foreground="#8b8b9e"
                            Padding="14,8" FontSize="13" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="📤 导出" Command="{Binding ExportDataCommand}"
                            Background="#252538" Foreground="#8b8b9e"
                            Padding="14,8" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filter Bar -->
        <Border Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters -->
                <Border Grid.Row="0" Background="#0a0a0f" Padding="20,12"
                        BorderBrush="#2a2a3e" BorderThickness="0,0,0,1">
                    <WrapPanel>
                        <TextBlock Text="筛选：" Foreground="#5a5a6e" FontSize="13" 
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="全部" Command="{Binding FilterEventLogCommand}" CommandParameter="all"
                                Padding="12,6" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#252538"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EventFilter}" Value="all">
                                            <Setter Property="Background" Value="#4361ee"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="🏀 得分" Command="{Binding FilterEventLogCommand}" CommandParameter="score"
                                Padding="12,6" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#252538"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EventFilter}" Value="score">
                                            <Setter Property="Background" Value="#4361ee"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="🚫 犯规" Command="{Binding FilterEventLogCommand}" CommandParameter="foul"
                                Padding="12,6" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#252538"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EventFilter}" Value="foul">
                                            <Setter Property="Background" Value="#ef233c"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="🔄 换人" Command="{Binding FilterEventLogCommand}" CommandParameter="substitution"
                                Padding="12,6" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#252538"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EventFilter}" Value="substitution">
                                            <Setter Property="Background" Value="#9b59b6"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="⏸ 暂停" Command="{Binding FilterEventLogCommand}" CommandParameter="timeout"
                                Padding="12,6" FontSize="12" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#252538"/>
                                    <Setter Property="Foreground" Value="#8b8b9e"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EventFilter}" Value="timeout">
                                            <Setter Property="Background" Value="#f39c12"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- Event List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                    <ItemsControl ItemsSource="{Binding FilteredEventLog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1a1a28" CornerRadius="12" 
                                        Padding="16,14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Event Type Badge -->
                                        <Border Grid.Column="0" Background="{Binding TypeBrush}" 
                                                CornerRadius="8" Padding="12,8" Margin="0,0,16,0"
                                                Width="70" HorizontalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TypeIcon}" FontSize="18" 
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding TypeLabel}" Foreground="White" 
                                                           FontSize="10" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Event Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" Foreground="White" 
                                                       FontSize="15" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Period, StringFormat='第 {0} 节'}" 
                                                           Foreground="#5a5a6e" FontSize="12" Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding TeamLabel}" 
                                                           Foreground="#8b8b9e" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" 
                                                   Foreground="#5a5a6e" FontSize="13"
                                                   FontFamily="Consolas" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

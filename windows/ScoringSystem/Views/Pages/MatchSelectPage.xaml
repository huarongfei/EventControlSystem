<UserControl x:Class="ScoringSystem.Views.Pages.MatchSelectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#12121a" Padding="28,20"
                BorderBrush="#2a2a3e" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="选择比赛" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="选择要裁判的比赛" Foreground="#8b8b9e" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1a1a28" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#06d6a0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerUrl}" Foreground="#8b8b9e" 
                                       FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Button Content="🔄 刷新" Command="{Binding LoadMatchesCommand}"
                            Background="#252538" Foreground="#8b8b9e"
                            Padding="14,8" FontSize="13" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter Tabs -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="全部" Command="{Binding FilterMatchListCommand}" CommandParameter="all"
                        Background="Transparent" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"
                        Foreground="#8b8b9e" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#8b8b9e"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="all">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="all">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#4361ee"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1e1e2e"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="进行中" Command="{Binding FilterMatchListCommand}" CommandParameter="live"
                        Background="Transparent" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"
                        Foreground="#8b8b9e" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#8b8b9e"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="live">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="live">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#06d6a0"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1e1e2e"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="未开始" Command="{Binding FilterMatchListCommand}" CommandParameter="upcoming"
                        Background="Transparent" BorderThickness="0" Padding="12,6" Margin="0,0,8,0"
                        Foreground="#8b8b9e" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#8b8b9e"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="upcoming">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="upcoming">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#f3c018"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1e1e2e"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="已结束" Command="{Binding FilterMatchListCommand}" CommandParameter="finished"
                        Background="Transparent" BorderThickness="0" Padding="12,6"
                        Foreground="#8b8b9e" FontSize="13" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#8b8b9e"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="finished">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding MatchListFilter}" Value="finished">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#5a5a6e"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1e1e2e"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            
            <!-- Empty state -->
            <Border Grid.Row="1" Background="#12121a" CornerRadius="12"
                    Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="暂无比赛" Foreground="#5a5a6e" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBlock Text="请先在比赛管理页面创建比赛" Foreground="#3a3a5e" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasMatches, Converter={StaticResource BoolToVisConverter}}">
                <ItemsControl ItemsSource="{Binding Matches}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1a1a28" CornerRadius="16" 
                                    Padding="24,20" Margin="0,0,0,12"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#000000" Opacity="0.3"/>
                                </Border.Effect>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectAndEnterMatchCommand, 
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Home Team -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Background="#4361ee" Width="48" Height="48" 
                                                CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding HomeTeam.ShortName}" Foreground="White" 
                                                       FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding HomeTeam.Name}" Foreground="White" 
                                                   FontSize="15" FontWeight="Bold" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Score -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="20,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding HomeScore}" 
                                                       Foreground="#4cc9f0" FontSize="40" FontWeight="Bold"
                                                       FontFamily="Consolas"/>
                                            <TextBlock Text=" : " Foreground="#5a5a6e" 
                                                       FontSize="40" FontWeight="Bold" FontFamily="Consolas"/>
                                            <TextBlock Text="{Binding AwayScore}" 
                                                       Foreground="#ef233c" FontSize="40" FontWeight="Bold"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Center" CornerRadius="6" Padding="10,4" Margin="0,6,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#252538"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="live">
                                                            <Setter Property="Background" Value="#0d3d2a"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="upcoming">
                                                            <Setter Property="Background" Value="#2a2a0d"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#8b8b9e"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="live">
                                                                <Setter Property="Foreground" Value="#06d6a0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="upcoming">
                                                                <Setter Property="Foreground" Value="#f3c018"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- Away Team -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border Background="#ef233c" Width="48" Height="48" 
                                                CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding AwayTeam.ShortName}" Foreground="White" 
                                                       FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding AwayTeam.Name}" Foreground="White" 
                                                   FontSize="15" FontWeight="Bold" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Enter Button -->
                                    <Button Grid.Column="3" Content="进入裁判 →"
                                            Command="{Binding DataContext.SelectAndEnterMatchCommand, 
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Background="#4361ee" Foreground="White"
                                            Padding="18,12" FontSize="14" FontWeight="SemiBold"
                                            BorderThickness="0" Cursor="Hand" Margin="16,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="2" Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="加载中..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="ScoringSystem.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" MaxWidth="600">
            <!-- Title -->
            <TextBlock Text="系统设置" Foreground="White" FontSize="24" 
                       FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="配置计分系统的参数和偏好" Foreground="#8b8b9e" 
                       FontSize="13" Margin="0,0,0,32"/>

            <!-- Network Settings -->
            <Border Background="#1a1a28" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#4361ee" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🌐" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="网络连接" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="服务器连接设置" Foreground="#5a5a6e" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="服务器地址" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#0a0a0f" CornerRadius="8" 
                                BorderBrush="#2a2a3e" BorderThickness="1" Margin="0,0,8,0">
                            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" FontSize="14" FontFamily="Consolas"
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0"/>
                        </Border>
                        <Button Grid.Column="1" Content="{Binding ConnectionButtonText}" 
                                Command="{Binding ConnectCommand}"
                                Padding="16,10" FontSize="13" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#4361ee"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#ef233c"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Border Background="#12121a" CornerRadius="8" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#06d6a0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="#8b8b9e" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Game Settings -->
            <Border Background="#1a1a28" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#06d6a0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="比赛规则" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="配置比赛时间和节次" Foreground="#5a5a6e" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="每节时长（分钟）" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,8"/>
                            <Border Background="#0a0a0f" CornerRadius="8" BorderBrush="#2a2a3e" BorderThickness="1">
                                <TextBox Text="{Binding PeriodDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" FontSize="15" FontFamily="Consolas"
                                         Background="Transparent" Foreground="White"
                                         BorderThickness="0"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="总节数" Foreground="#8b8b9e" FontSize="13" Margin="0,0,0,8"/>
                            <Border Background="#0a0a0f" CornerRadius="8" BorderBrush="#2a2a3e" BorderThickness="1">
                                <TextBox Text="{Binding TotalPeriods, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,10" FontSize="15" FontFamily="Consolas"
                                         Background="Transparent" Foreground="White"
                                         BorderThickness="0"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Keyboard Shortcuts -->
            <Border Background="#1a1a28" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#9b59b6" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="⌨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="键盘快捷键" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="快速操作的键盘绑定" Foreground="#5a5a6e" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <Border Background="#12121a" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#252538" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="1 / 2 / 3" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="主队 +1/+2/+3" Foreground="#8b8b9e" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="#12121a" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#252538" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="7 / 8 / 9" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="客队 +1/+2/+3" Foreground="#8b8b9e" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="#12121a" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#252538" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="Space" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="开始/暂停计时" Foreground="#8b8b9e" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Border Background="#12121a" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#252538" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="← / →" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="切换节次" Foreground="#8b8b9e" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="#12121a" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#252538" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="F1" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="显示帮助" Foreground="#8b8b9e" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Background="#12121a" CornerRadius="8" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#252538" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                        <TextBlock Text="Esc" Foreground="White" FontSize="12" FontFamily="Consolas" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="关闭弹窗" Foreground="#8b8b9e" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backend Service Management -->
            <Border Background="#1a1a28" CornerRadius="16" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Background="#f39c12" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="🚀" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="后台服务管理" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="一键启动/停止 Node.js 后端和 Web 前端" Foreground="#5a5a6e" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Start Buttons -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Start All -->
                        <Button Grid.Column="0" Command="{Binding StartAllBackendServicesCommand}"
                                Margin="0,0,6,0" Height="48" BorderThickness="0" Cursor="Hand"
                                Background="#06d6a0" Foreground="White">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="一键启动全部" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Stop All -->
                        <Button Grid.Column="1" Command="{Binding StopAllBackendServicesCommand}"
                                Margin="6,0,0,0" Height="48" BorderThickness="0" Cursor="Hand"
                                Background="#ef233c" Foreground="White">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⏹" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="全部停止" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Service Status Cards -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Backend Server -->
                        <Border Grid.Column="0" Background="#12121a" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#ef233c"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBackendRunning}" Value="True">
                                                        <Setter Property="Fill" Value="#06d6a0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Node.js 后端" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Foreground="#5a5a6e" FontSize="11" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="状态: 已停止"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBackendRunning}" Value="True">
                                                    <Setter Property="Text" Value="状态: 运行中 (localhost:3001)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding StartBackendServerCommand}" Content="启动"
                                            Padding="12,6" FontSize="11" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                            Background="#06d6a0" Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Command="{Binding StopBackendServerCommand}" Content="停止"
                                            Padding="12,6" FontSize="11" BorderThickness="0" Cursor="Hand"
                                            Background="#ef233c" Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Web Frontend -->
                        <Border Grid.Column="2" Background="#12121a" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#ef233c"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWebRunning}" Value="True">
                                                        <Setter Property="Fill" Value="#06d6a0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="Web 数据展板" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Foreground="#5a5a6e" FontSize="11" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="状态: 已停止"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWebRunning}" Value="True">
                                                    <Setter Property="Text" Value="状态: 运行中 (localhost:5173)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding StartWebServerCommand}" Content="启动"
                                            Padding="12,6" FontSize="11" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"
                                            Background="#06d6a0" Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Command="{Binding StopWebServerCommand}" Content="停止"
                                            Padding="12,6" FontSize="11" BorderThickness="0" Cursor="Hand"
                                            Background="#ef233c" Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Service Log -->
                    <Border Background="#0a0a0f" CornerRadius="10" Padding="12" MaxHeight="180">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="服务日志" Foreground="#8b8b9e" FontSize="12" FontWeight="SemiBold"/>
                                <Button Command="{Binding ClearBackendLogCommand}" Content="清空"
                                        Padding="8,2" Margin="12,0,0,0" FontSize="10" BorderThickness="0" Cursor="Hand"
                                        Background="#252538" Foreground="#8b8b9e">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding BackendLogText}" Foreground="#5a5a6e" FontSize="11" 
                                           FontFamily="Consolas" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Quick Links -->
                    <Border Background="#12121a" CornerRadius="8" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="快速访问" Foreground="#8b8b9e" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Click="OpenWebPanel_Click" Content="🌐 打开 Web 展板"
                                        Padding="12,8" FontSize="12" BorderThickness="0" Cursor="Hand"
                                        Background="#4361ee" Foreground="White" Margin="0,0,8,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Click="OpenApiTest_Click" Content="🔗 打开 API 测试"
                                        Padding="12,8" FontSize="12" BorderThickness="0" Cursor="Hand"
                                        Background="#252538" Foreground="#8b8b9e">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Save Button -->
            <Button Content="💾 保存设置" Command="{Binding SaveSettingsCommand}"
                    Height="50" FontSize="16" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Background="#4361ee" Foreground="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>

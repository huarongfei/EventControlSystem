<UserControl x:Class="ScoringSystem.Views.Pages.TeamManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScoringSystem.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="4" BlurRadius="20" Color="#000000" Opacity="0.4"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#12121a" Padding="28,20"
                BorderBrush="#2a2a3e" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="队伍管理" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="添加、编辑和删除参赛队伍" Foreground="#8b8b9e" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Background="#1a1a28" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#555"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#06d6a0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ServerUrl}" Foreground="#8b8b9e"
                                       FontSize="12" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                    <Button Content="➕ 添加队伍" Command="{Binding CreateTeamCommand}"
                            Background="#06d6a0" Foreground="White"
                            Padding="14,8" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#05b88a"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Team List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Empty State -->
                    <Border Background="#12121a" CornerRadius="12" Padding="40"
                            Visibility="{Binding HasNoTeams, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="暂无队伍" Foreground="#5a5a6e" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击「添加队伍」添加第一支参赛队伍" Foreground="#3a3a5e" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Team Cards -->
                    <ItemsControl ItemsSource="{Binding Teams}"
                                  Visibility="{Binding HasTeams, Converter={StaticResource BoolToVisConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1a1a28" CornerRadius="16"
                                    Padding="24,20" Margin="0,0,0,12">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="20" Color="#000000" Opacity="0.3"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Team Logo -->
                                    <Border Grid.Column="0" Background="#4361ee"
                                            Width="56" Height="56" CornerRadius="12"
                                            Margin="0,0,20,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4361ee"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShortName}" Value="红队">
                                                        <Setter Property="Background" Value="#ef233c"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShortName}" Value="蓝队">
                                                        <Setter Property="Background" Value="#4361ee"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShortName}" Value="绿队">
                                                        <Setter Property="Background" Value="#06d6a0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShortName}" Value="黄队">
                                                        <Setter Property="Background" Value="#f39c12"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ShortName}" Foreground="White"
                                                   FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Team Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                   FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Foreground="#5a5a6e" FontSize="13" Margin="0,4,0,0">
                                            <Run Text="简称: "/>
                                            <Run Text="{Binding ShortName, Mode=OneWay}"/>
                                            <Run Text=" | ID: "/>
                                            <Run Text="{Binding Id, Mode=OneWay}" FontFamily="Consolas"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="✏ 编辑" Command="{Binding DataContext.EditTeamCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#252538" Foreground="#8b8b9e"
                                                Padding="12,8" FontSize="12" BorderThickness="0"
                                                Cursor="Hand" Margin="0,0,8,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑 删除" Command="{Binding DataContext.DeleteTeamCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#3d0d0d" Foreground="#ef233c"
                                                Padding="12,8" FontSize="12" BorderThickness="0"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Border Grid.ColumnSpan="1" Background="#80000000"
                    Visibility="{Binding IsTeamsLoading, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="加载中..." Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add/Edit Team Modal -->
        <Border Grid.RowSpan="2" Background="#cc000000"
                Visibility="{Binding IsTeamDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#1a1a28" CornerRadius="20" Width="450"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="{Binding TeamDialogTitle}" Foreground="White"
                               FontSize="20" FontWeight="Bold" Margin="0,0,0,24"/>

                    <!-- Form -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,24">
                        <!-- Team Name -->
                        <TextBlock Text="队伍名称 *" Foreground="#8b8b9e" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewTeamName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0a0a0f" Foreground="White"
                                 BorderBrush="#2a2a3e" BorderThickness="1"
                                 Padding="12,10" FontSize="14"
                                 Margin="0,0,0,16">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#4361ee"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Short Name -->
                        <TextBlock Text="队伍简称 (2-4个字符) *" Foreground="#8b8b9e" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewTeamShortName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0a0a0f" Foreground="White"
                                 BorderBrush="#2a2a3e" BorderThickness="1"
                                 Padding="12,10" FontSize="14" MaxLength="4"
                                 Margin="0,0,0,16">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#4361ee"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Logo URL (Optional) -->
                        <TextBlock Text="Logo URL (可选)" Foreground="#8b8b9e" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding NewTeamLogoUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#0a0a0f" Foreground="White"
                                 BorderBrush="#2a2a3e" BorderThickness="1"
                                 Padding="12,10" FontSize="14"
                                 Margin="0,0,0,8">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="#4361ee"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelTeamDialogCommand}"
                                Background="#252538" Foreground="#8b8b9e"
                                Padding="20,10" FontSize="13" BorderThickness="0" Cursor="Hand"
                                Margin="0,0,12,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2a2a3e"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{Binding TeamDialogButtonText}" Command="{Binding ConfirmTeamDialogCommand}"
                                Background="#4361ee" Foreground="White"
                                Padding="20,10" FontSize="13" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#3a56d4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
